<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #161625;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="backend.demoLoadController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="100.0" layoutY="28.0" prefHeight="780.0" prefWidth="1100.0" spacing="50.0">
         <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/download11.png" />
               </image>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </ImageView>
            <ImageView fx:id="loadingBar" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/download13.png" />
               </image>
               <VBox.margin>
                  <Insets top="350.0" />
               </VBox.margin>
            </ImageView>
            <Text fx:id="loadingText" fill="#86aaf9" strokeType="OUTSIDE" strokeWidth="0.0" text="The application is loading with an estimation time of three minutes...">
               <font>
                  <Font name="System Bold Italic" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
      <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="1125.0" layoutY="8.0" onMouseClicked="#minimize" onMouseEntered="#hover" onMouseExited="#unhover" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../resources/download8.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="1170.0" layoutY="8.0" onMouseClicked="#close" onMouseEntered="#hover" onMouseExited="#unhover" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../resources/download7.png" />
         </image>
      </ImageView>
      <Label alignment="CENTER" layoutY="780.0" prefHeight="20.0" prefWidth="100.0" text="VERSION 2.1" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="System Bold" size="10.0" />
         </font>
      </Label>
   </children>
</Pane>
